    <model name="scene3_water">
      <static>true</static>
      <link name="env_water">
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://scene3_parts/env_water.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>21</label></plugin></visual>
        <collision name="collision"><pose>-161.7 -30.5 -12.05 0 0 0</pose><geometry><box><size>966 1239 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- CODEBRIM defect decals (tools_scene3_defects.py); ground truth in scene3_defects/defects_gt.json -->
    <model name="scene3_defects">
      <static>true</static>
      <link name="defects">
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://scene3_defects/defects.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>30</label></plugin></visual>
      </link>
    </model>
    <!-- PARTS END -->

    <!-- ArduPilot-controlled quad (SITL connects on UDP 9002). Spawn on the z=0.6 m deck at origin. -->
    <!-- invisible take-off/landing pad on the deck: DART sticks to triangle-mesh contacts, a box is clean -->
    <model name="deck_pad">
      <static>true</static>
      <pose>4 -170 0.6 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3 3 0.06</size></box></geometry></collision></link>
    </model>

    <!-- ArduPilot-controlled quad with mapping lidar + RGB-D camera (SITL connects on UDP 9002).
         Spawns on the deck in a lane over the arch span (inside scene.region), facing along the bridge (+Y). -->
    <include>
      <uri>model://iris_mapper</uri>
      <name>iris</name>
      <pose degrees="true">4 -170 0.88 0 0 90</pose>
    </include>
  </world>
</sdf>
