    <model name="scene1_other">
      <static>true</static>
      <link name="link">
        <visual name="visual"><geometry><mesh><uri>model://scene1_parts/env_other.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>25</label></plugin></visual>
      </link>
    </model>

    <!-- invisible take-off/landing pad on the deck: DART sticks to triangle-mesh contacts, a box is clean -->
    <model name="deck_pad">
      <static>true</static>
      <pose>-70.8 -8.85 11.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3 3 0.06</size></box></geometry></collision></link>
    </model>

    <!-- ArduPilot-controlled quad with mapping lidar + RGB-D camera (SITL connects on UDP 9002).
         Spawns on the deck at mid-span between piers 4 and 5, facing along the bridge (+X). -->
    <include>
      <uri>model://iris_mapper</uri>
      <name>iris</name>
      <pose degrees="true">-70.8 -8.85 11.78 0 0 0</pose>
    </include>
  </world>
</sdf>
