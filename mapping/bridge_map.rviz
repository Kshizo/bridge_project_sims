Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 32; 38
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Color: 80; 80; 90
      Offset: {X: -4.8, Y: 47.5, Z: 0}
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (drone's own, coloured by height)
      Enabled: true
      Topic: {Value: /bridge/map, Depth: 1, Reliability Policy: Reliable, Durability Policy: Volatile, History Policy: Keep Last}
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Queue Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Live scan
      Enabled: true
      Topic: {Value: /bridge/scan, Depth: 1, Reliability Policy: Reliable, Durability Policy: Volatile, History Policy: Keep Last}
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Drone path (its own estimate)
      Enabled: true
      Topic: {Value: /bridge/path, Depth: 1, Reliability Policy: Reliable, Durability Policy: Volatile, History Policy: Keep Last}
      Color: 255; 160; 0
      Line Style: Lines
    - Class: rviz_default_plugins/MarkerArray
      Name: GPS (planned path, flown path by fix, lost/regained, status)
      Enabled: true
      Topic: {Value: /bridge/gps, Depth: 1, Reliability Policy: Reliable, Durability Policy: Volatile, History Policy: Keep Last}
      Namespaces: {planned_path: true, flown_gps: true, gps_events: true, drone_status: true}
    - Class: rviz_default_plugins/MarkerArray
      Name: Referee (ground truth - evaluation only)
      Enabled: true
      Topic: {Value: /eval/markers, Depth: 1, Reliability Policy: Reliable, Durability Policy: Volatile, History Policy: Keep Last}
      Namespaces: {true_gps_shadow: true, true_path: true, truth_label: true}
    - Class: rviz_default_plugins/Image
      Name: Camera (RGB)
      Enabled: true
      Topic: {Value: /bridge/camera, Depth: 1, Reliability Policy: Best Effort, Durability Policy: Volatile, History Policy: Keep Last}
      Normalize Range: true
    - Class: rviz_default_plugins/TF
      Name: Drone
      Enabled: true
      Marker Scale: 4
      Show Names: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 120
      Focal Point: {X: -4.8, Y: 47.5, Z: 4}
      Pitch: 0.55
      Yaw: 5.2
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 900
